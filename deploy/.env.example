# Blueprinted — environment variable reference
#
# Copy this file to .env at the repo root and fill in all required values
# before running `docker compose -f deploy/docker-compose.yml up`.
#
# Required values are marked (required). Defaults shown for optional values.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Runtime environment. Options: development | production
APP_ENV=production

# Secret key used for signing. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=  # (required)

# Log level. Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------

POSTGRES_USER=blueprinted
POSTGRES_PASSWORD=  # (required)
POSTGRES_DB=blueprinted

# Port exposed on the host (default: 5432)
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Port exposed on the host (default: 6379)
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Authentik (OIDC identity provider)
# Sprint 2: after Authentik is configured, fill in OIDC_* values
# ---------------------------------------------------------------------------

# Authentik database password (required)
AUTHENTIK_DB_PASSWORD=  # (required)

# Authentik secret key — generate independently from APP_SECRET_KEY
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTHENTIK_SECRET_KEY=  # (required)

# HTTP/HTTPS ports exposed on the host
AUTHENTIK_PORT_HTTP=9000
AUTHENTIK_PORT_HTTPS=9443

# OIDC configuration — filled after Authentik OIDC client is created.
# See docs/authentik-setup.md for step-by-step instructions.

# Issuer URL — found in Authentik: Applications → Providers → your provider → "OpenID Configuration Issuer"
OIDC_ISSUER=

# Client ID — the Authentik application slug
OIDC_CLIENT_ID=

# Client secret — from the Authentik provider credentials tab
OIDC_CLIENT_SECRET=

# JWKS URI — found in Authentik: Applications → Providers → your provider → "JWKS URL"
OIDC_JWKS_URI=

# Audience — must match the "Client ID / Application slug" configured in the Authentik provider
OIDC_AUDIENCE=

# JWT claim that carries the user's roles list (default: "roles").
# Must match the Authentik property mapping configured for this provider.
OIDC_ROLES_CLAIM=roles

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Options: local | s3
STORAGE_BACKEND=local

# Local storage: path inside the container (mounted volume in compose)
# No change needed unless overriding the volume mount point
# STORAGE_LOCAL_ROOT=/app/uploads

# S3-compatible storage (only required when STORAGE_BACKEND=s3)
# STORAGE_BUCKET=blueprinted
# STORAGE_ENDPOINT=https://s3.amazonaws.com   # or MinIO / R2 endpoint
# STORAGE_KEY=                                 # access key ID
# STORAGE_SECRET=                              # secret access key

# ---------------------------------------------------------------------------
# MinIO (optional S3-compatible storage — enable with --profile storage)
# ---------------------------------------------------------------------------

# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=   # (required when storage profile is active)
# MINIO_PORT=9100
# MINIO_CONSOLE_PORT=9101

# ---------------------------------------------------------------------------
# API server port
# ---------------------------------------------------------------------------
API_PORT=8000
